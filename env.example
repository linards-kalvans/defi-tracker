# Database Configuration
# For Neon.tech or any other external Postgres:
# Ensure you copy the "Pooled Connection" string if available, or the Direct one.
# Neon example: postgres://user:password@ep-host-123.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname?sslmode=require

# Frontend API URL
# On VPS, this should be your domain name or public IP
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP_OR_DOMAIN:8000
NEXT_PUBLIC_WS_URL=ws://YOUR_VPS_IP_OR_DOMAIN:8000
